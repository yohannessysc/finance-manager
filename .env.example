# Copy to .env (never commit .env). Values for docker-compose.yml.

POSTGRES_PASSWORD=change-me

# Public URL of the web app, used in email links and Stripe redirects.
Frontend__BaseUrl=http://localhost:8080

# Key-encryption certificate for ASP.NET Data Protection (see docs/deployment.md).
DATAPROTECTION_CERT_FILE=./secrets/dataprotection.pfx
DATAPROTECTION_CERT_PASSWORD=

# Email (Resend) — From must use your verified domain.
Resend__ApiKey=
Resend__From=Finance Manager <noreply@your-domain.com>

# Plaid
Plaid__ClientId=
Plaid__Secret=
Plaid__Environment=sandbox

# Stripe billing
Billing__StripeSecretKey=
Billing__StripeWebhookSecret=
Billing__Bank__MonthlyPriceId=
Billing__Bank__YearlyPriceId=
Billing__Premium__MonthlyPriceId=
Billing__Premium__YearlyPriceId=
Billing__TrialDays=0

# Error tracking (optional)
Sentry__Dsn=
